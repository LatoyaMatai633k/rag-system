# Required for live answers. Create a .env file locally; never commit it.
OPENROUTER_API_KEY=

# Preserves the model used in the original notebook.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Comma-separated frontend origins. Keep localhost while developing.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local paths, relative to the repository root unless made absolute.
DATA_DIR=data
PACK_DIR=query_rewriting_pack
